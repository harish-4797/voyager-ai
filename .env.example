# Groq API key — server-side only. Do NOT prefix it with VITE_ (that would expose it in the browser).
GROQ_API_KEY="your-groq-api-key-here"

# Optional: preferred model (defaults to openai/gpt-oss-120b). Safe to expose.
VITE_GROQ_MODEL="openai/gpt-oss-120b"

# Optional: accounts + cloud database (Supabase). Leave empty to run in local mode
# (trips saved in the browser). The anon/publishable key is designed to be public —
# Row Level Security (supabase/schema.sql) keeps each user's data private.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
