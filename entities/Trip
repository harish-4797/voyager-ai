    },
    "city": {
      "type": "string",
      "description": "Destination city"
    },
    "country": {
      "type": "string"
    },
    "days": {
      "type": "number",
      "description": "Number of days"
    },
    "budget": {
      "type": "number",
      "description": "Total budget in USD"
    },
    "month": {
      "type": "string",
      "description": "Travel month"
